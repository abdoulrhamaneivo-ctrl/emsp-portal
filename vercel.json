{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "true",
  "buildCommand": "sh scripts/build-vercel-static.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://emsp-portal.onrender.com/"
    },
    {
      "source": "/:path*",
      "destination": "https://emsp-portal.onrender.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/media/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
